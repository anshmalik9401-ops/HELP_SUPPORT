PORT=5000
# Support mail shown to the client when no answer is found
SUPPORT_EMAIL=support1@nimbusitsolutions.com
BRAND_NAME=Nimbus
PANEL_URL=https://omnidigital.co.in/
# Password of the admin ("Add more") page. Change it. Empty = admin disabled.
ADMIN_KEY=change-this-admin-key
# Optional: if set, unanswered queries / feedback are saved in MongoDB, otherwise in files under logs/.
# MONGO_URI=mongodb://127.0.0.1:27017/help_support

# "Ask AI" option (Gemini with OpenRouter fallback). Keys stay on the server only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Optional fallback for temporary model overload (default: gemini-3.6-flash).
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Optional fallback provider when Gemini is unavailable. Keep this key server-side.
OPENROUTER_API_KEY=replace-with-your-rotated-openrouter-key
# OPENROUTER_MODEL=openai/gpt-4o
# Set to false to disable Nia.
# AI_ENABLED=false
